+{
+    assert(vnet >= 0 && vnet < vnets);
+    assert(src >= 0 && src < n);
+    assert(dst >= 0 && dst < n);
+    auto &row = adj[vnet][src];
+    for (auto &entry : row) {
+        if (entry.first == dst) {
+            entry.second = weight;
+            return;
+        }
+    }
+    row.emplace_back(dst, weight);
